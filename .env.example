# DeepSeek API配置
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 数据库配置（可选，默认使用SQLite）
# DATABASE_URL=sqlite:///./data/moving.db

# API配置
API_HOST=0.0.0.0
API_PORT=8000

# CORS配置（逗号分隔的域名列表）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
